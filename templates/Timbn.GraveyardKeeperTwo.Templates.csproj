<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageType>Template</PackageType>
    <PackageId>Timbn.GraveyardKeeperTwo.Templates</PackageId>
    <Title>Timbn Graveyard Keeper 2 mod templates</Title>
    <Version>1.0.0</Version>
    <Authors>Timbn</Authors>
    <Description>A dotnet new template for a Graveyard Keeper 2 mod built on Timbn Core. Run dotnet new gk2mod.</Description>
    <PackageTags>graveyardkeeper2;bepinex;modding;template</PackageTags>
    <PackageLicenseExpression>MPL-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://timbnmods.github.io/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/TimbnMods/Timbn.GraveyardKeeperTwo</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageOutputPath>$(MSBuildThisFileDirectory)..\artifacts\</PackageOutputPath>
    <TargetFramework>netstandard2.1</TargetFramework>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <IncludeContentInPack>true</IncludeContentInPack>
    <ContentTargetFolders>content</ContentTargetFolders>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
    <EnableDefaultItems>false</EnableDefaultItems>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="content\**\*" Exclude="content\**\bin\**;content\**\obj\**" />
  </ItemGroup>

</Project>

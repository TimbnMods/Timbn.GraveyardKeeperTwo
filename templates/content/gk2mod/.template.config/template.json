{
  "$schema": "http://json.schemastore.org/template",
  "author": "Timbn",
  "classifications": ["Graveyard Keeper 2", "BepInEx", "Mod"],
  "identity": "Timbn.GraveyardKeeperTwo.Template.Mod",
  "name": "Graveyard Keeper 2 mod",
  "shortName": "gk2mod",
  "sourceName": "MyMod",
  "preferNameDirectory": true,
  "tags": {
    "language": "C#",
    "type": "project"
  },
  "symbols": {
    "deployTo": {
      "type": "parameter",
      "datatype": "choice",
      "description": "Where a build copies the mod. scripts supports F6 reload in game, plugins loads once at startup.",
      "choices": [
        { "choice": "scripts", "description": "BepInEx/scripts, hot reloaded with F6" },
        { "choice": "plugins", "description": "BepInEx/plugins, loaded at startup" }
      ],
      "defaultValue": "scripts",
      "replaces": "DEPLOYTO"
    },
    "gameDir": {
      "type": "parameter",
      "datatype": "text",
      "description": "The Graveyard Keeper 2 install folder.",
      "defaultValue": "C:\\Program Files (x86)\\Steam\\steamapps\\common\\Graveyard Keeper 2",
      "replaces": "GAMEDIR"
    }
  }
}

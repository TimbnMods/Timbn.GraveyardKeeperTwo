<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <Version>1.0.0</Version>
    <DebugType>embedded</DebugType>
    <RestoreAdditionalProjectSources>https://nuget.bepinex.dev/v3/index.json</RestoreAdditionalProjectSources>
  </PropertyGroup>

  <!-- Point GameDir at your Graveyard Keeper 2 folder. The game's DLLs are read from there and never copied. -->
  <PropertyGroup>
    <GameDir>GAMEDIR</GameDir>
    <GameManagedDir>$(GameDir)\GraveyardKeeper2_Data\Managed</GameManagedDir>
    <BepInExDir>$(GameDir)\BepInEx</BepInExDir>
    <DeployTo>DEPLOYTO</DeployTo>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.Analyzers" Version="1.*" PrivateAssets="all" />
    <PackageReference Include="BepInEx.Core" Version="5.*" />
    <PackageReference Include="BepInEx.PluginInfoProps" Version="2.*" PrivateAssets="all" />
    <PackageReference Include="UnityEngine.Modules" Version="6000.3.9" IncludeAssets="compile" />
    <PackageReference Include="Timbn.GraveyardKeeperTwo.Core" Version="2.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="lang\*.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Copies the DLL and lang files to BepInEx/<DeployTo>/<ProjectName> after each build, and removes the other folder's copy so the mod never loads twice. -->
  <PropertyGroup>
    <_OtherFolder Condition="'$(DeployTo)' == 'scripts'">plugins</_OtherFolder>
    <_OtherFolder Condition="'$(DeployTo)' == 'plugins'">scripts</_OtherFolder>
    <_DeployDir>$(BepInExDir)\$(DeployTo)\$(MSBuildProjectName)</_DeployDir>
  </PropertyGroup>

  <Target Name="DeployToGame" AfterTargets="Build" Condition="Exists('$(BepInExDir)')">
    <ItemGroup>
      <_DeployContent Include="@(None->WithMetadataValue('CopyToOutputDirectory', 'PreserveNewest'))" />
    </ItemGroup>
    <RemoveDir Directories="$(BepInExDir)\$(_OtherFolder)\$(MSBuildProjectName);$(_DeployDir)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(_DeployDir)" />
    <Copy
      SourceFiles="@(_DeployContent)"
      DestinationFiles="@(_DeployContent->'$(_DeployDir)\%(RelativeDir)%(Filename)%(Extension)')"
      Condition="'@(_DeployContent)' != ''" />
    <Message Importance="high" Text="Deployed $(MSBuildProjectName) to $(_DeployDir)" />
  </Target>

</Project>

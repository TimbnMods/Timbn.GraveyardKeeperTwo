<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>Timbn.GraveyardKeeperTwo.Core</AssemblyName>
    <Product>Timbn Core</Product>
    <Version>2.2.0</Version>
    <Thunderstore>true</Thunderstore>
    <ThunderstoreCategories>mods;libraries</ThunderstoreCategories>
    <SteamWorkshop>true</SteamWorkshop>
    <WorkshopItemId>3810064587</WorkshopItemId>
    <NexusModId>84</NexusModId>
  </PropertyGroup>

  <!-- Core is what every other mod references, so it always deploys to plugins and is never hot reloaded. -->
  <PropertyGroup>
    <ScriptReloadable>false</ScriptReloadable>
  </PropertyGroup>

  <!-- Core is the only packable mod, so another mod can reference it from NuGet rather than a local build. -->
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <EmbedAllSources>true</EmbedAllSources>
    <PackageOutputPath>$(MSBuildThisFileDirectory)..\..\artifacts\</PackageOutputPath>
    <PackageId>Timbn.GraveyardKeeperTwo.Core</PackageId>
    <Title>Timbn Graveyard Keeper 2 Core</Title>
    <Authors>Timbn</Authors>
    <Description>Shared framework for Graveyard Keeper 2 (BepInEx 5) mods. A plugin base class with auto patching and config, plus the Core mod that hosts it.</Description>
    <PackageTags>graveyardkeeper2;bepinex;modding;unity</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MPL-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://timbnmods.github.io/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/TimbnMods/Timbn.GraveyardKeeperTwo</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReleaseNotes>
      - Core 2.2.0 adds the Mods window, pages in the game's own look, interaction spots, key hints and more player, world and quest helpers. See CHANGELOG.md.
    </PackageReleaseNotes>
    <!-- Compile only. The running Core comes from the mod download, so a consumer must never copy it next to its own plugin. -->
    <BuildOutputTargetFolder>ref</BuildOutputTargetFolder>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>..\..\lib\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp-firstpass">
      <HintPath>..\..\lib\Assembly-CSharp-firstpass.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="AstarPathfindingProject">
      <HintPath>$(GameManagedDir)\AstarPathfindingProject.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="PackageTools">
      <HintPath>$(GameManagedDir)\PackageTools.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Drawing">
      <HintPath>$(GameManagedDir)\Drawing.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="FlowCanvas">
      <HintPath>$(GameManagedDir)\FlowCanvas.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="LazyBearTechnology">
      <HintPath>$(GameManagedDir)\LazyBearTechnology.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="NodeCanvas">
      <HintPath>$(GameManagedDir)\NodeCanvas.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="ParadoxNotion">
      <HintPath>$(GameManagedDir)\ParadoxNotion.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Sirenix.Serialization">
      <HintPath>$(GameManagedDir)\Sirenix.Serialization.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Sirenix.Serialization.Config">
      <HintPath>$(GameManagedDir)\Sirenix.Serialization.Config.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(GameManagedDir)\Newtonsoft.Json.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="com.rlabrecque.steamworks.net">
      <HintPath>$(GameManagedDir)\com.rlabrecque.steamworks.net.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.Addressables">
      <HintPath>$(GameManagedDir)\Unity.Addressables.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.ResourceManager">
      <HintPath>$(GameManagedDir)\Unity.ResourceManager.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UniTask">
      <HintPath>$(GameManagedDir)\UniTask.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.TextMeshPro">
      <HintPath>$(GameManagedDir)\Unity.TextMeshPro.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(GameManagedDir)\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="build\Timbn.GraveyardKeeperTwo.Core.props" Pack="true" PackagePath="build\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Timbn.GraveyardKeeperTwo.Core.Tests" />
    <InternalsVisibleTo Include="Timbn.GraveyardKeeperTwo.InfoDump" />
    <InternalsVisibleTo Include="Timbn.GraveyardKeeperTwo.QuestPacks" />
  </ItemGroup>

</Project>

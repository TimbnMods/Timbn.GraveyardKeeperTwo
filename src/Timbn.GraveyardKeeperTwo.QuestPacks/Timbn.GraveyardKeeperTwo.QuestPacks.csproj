<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>Timbn.GraveyardKeeperTwo.QuestPacks</AssemblyName>
    <Product>Timbn Quest Packs</Product>
    <Version>1.0.0</Version>
    <SteamWorkshop>true</SteamWorkshop>
    <WorkshopItemId>0</WorkshopItemId>
  </PropertyGroup>

  <!-- It reaches Core's internals, which only an assembly with this exact name may do, and ScriptEngine renames what it loads. -->
  <PropertyGroup>
    <ScriptReloadable>false</ScriptReloadable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Timbn.GraveyardKeeperTwo.Core\Timbn.GraveyardKeeperTwo.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>..\..\lib\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="LazyBearTechnology">
      <HintPath>$(GameManagedDir)\LazyBearTechnology.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(GameManagedDir)\Newtonsoft.Json.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Timbn.GraveyardKeeperTwo.Core.Tests" />
  </ItemGroup>

</Project>

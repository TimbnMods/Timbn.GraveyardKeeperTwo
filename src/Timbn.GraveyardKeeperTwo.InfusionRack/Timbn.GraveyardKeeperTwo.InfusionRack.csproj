<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>Timbn.GraveyardKeeperTwo.InfusionRack</AssemblyName>
    <Product>Timbn Infusion Rack</Product>
    <Version>1.1.1</Version>
    <WorkshopItemId>3821083540</WorkshopItemId>
    <NexusModId>395</NexusModId>
    <Thunderstore>true</Thunderstore>
    <Description>Give your zombies tech points. Make Spirit Solutions from organs, lay zombies in infusion stands and run an infusion on the infusion machine to pay each one the full points.</Description>
    <SteamWorkshop>true</SteamWorkshop>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Art\*.png" LogicalName="%(Filename)%(Extension)" />
    <EmbeddedResource Include="Icons\*.png" LogicalName="%(Filename)%(Extension)" />
    <None Include="lang\*.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Lands in BepInEx/scripts by default so F6 reloads it. Pass -p:DeployTo=plugins to load it at startup instead. -->
  <PropertyGroup>
    <DeployTo>scripts</DeployTo>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Timbn.GraveyardKeeperTwo.Core\Timbn.GraveyardKeeperTwo.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>..\..\lib\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="LazyBearTechnology">
      <HintPath>$(GameManagedDir)\LazyBearTechnology.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>

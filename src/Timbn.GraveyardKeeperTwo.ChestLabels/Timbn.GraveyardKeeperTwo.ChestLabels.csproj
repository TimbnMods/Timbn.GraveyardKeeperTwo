<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>Timbn.GraveyardKeeperTwo.ChestLabels</AssemblyName>
    <Product>Timbn Chest Labels</Product>
    <Version>1.0.0</Version>
    <Thunderstore>true</Thunderstore>
    <Description>Name your chests. Press the Work key at a chest and type a label, and it shows over the chest in the same style as grave quality.</Description>
    <WorkshopItemId>3821251395</WorkshopItemId>
    <NexusModId>398</NexusModId>
  </PropertyGroup>

  <!-- Lands in BepInEx/scripts by default so F6 reloads it. Pass -p:DeployTo=plugins to load it at startup instead. -->
  <PropertyGroup>
    <DeployTo>scripts</DeployTo>
  </PropertyGroup>

  <ItemGroup>
    <None Include="lang\*.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Timbn.GraveyardKeeperTwo.Core\Timbn.GraveyardKeeperTwo.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>..\..\lib\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="LazyBearTechnology">
      <HintPath>$(GameManagedDir)\LazyBearTechnology.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>

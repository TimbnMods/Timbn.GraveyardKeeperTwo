<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>Timbn.GraveyardKeeperTwo.LivingTown</AssemblyName>
    <Product>Timbn Living Town</Product>
    <Version>1.1.0</Version>
    <WorkshopItemId>3821083573</WorkshopItemId>
    <NexusModId>394</NexusModId>
    <Thunderstore>true</Thunderstore>
    <SteamWorkshop>true</SteamWorkshop>
  </PropertyGroup>

  <!-- Lands in BepInEx/scripts by default so F6 reloads it. Pass -p:DeployTo=plugins to load it at startup instead. -->
  <PropertyGroup>
    <DeployTo>scripts</DeployTo>
  </PropertyGroup>

  <ItemGroup>
    <None Include="lang\*.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Timbn.GraveyardKeeperTwo.Core\Timbn.GraveyardKeeperTwo.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>..\..\lib\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="LazyBearTechnology">
      <HintPath>$(GameManagedDir)\LazyBearTechnology.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>

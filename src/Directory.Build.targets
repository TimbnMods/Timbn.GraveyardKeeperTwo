<Project>

  <!--
    Where a build lands. DeployTo is plugins (loaded once by the chainloader) or scripts (hot reloaded by
    ScriptEngine on F6), passed as -p:DeployTo=scripts. A project that must never be reloaded, such as Core,
    sets ScriptReloadable false and always goes to plugins. A preloader patcher sets BepInExPatcher true and
    always goes to patchers. A mod is removed from the other folder so it can never be loaded twice. PluginDir
    is kept as the name the Exists gate and the docs use, so -p:PluginDir=Z:/nope still compiles without
    deploying while the game runs.
  -->
  <PropertyGroup>
    <_DeployFolder>$(DeployTo)</_DeployFolder>
    <_DeployFolder Condition="'$(ScriptReloadable)' != 'true'">plugins</_DeployFolder>
    <_DeployFolder Condition="'$(BepInExPatcher)' == 'true'">patchers</_DeployFolder>
    <_OtherFolder Condition="'$(_DeployFolder)' == 'plugins'">scripts</_OtherFolder>
    <_OtherFolder Condition="'$(_DeployFolder)' == 'scripts'">plugins</_OtherFolder>
    <_DefaultPluginDir>$(BepInExDir)\$(_DeployFolder)</_DefaultPluginDir>
    <PluginDir Condition="'$(PluginDir)' == ''">$(_DefaultPluginDir)</PluginDir>
  </PropertyGroup>

  <!--
    Copies each plugin into BepInEx/<folder>/<ProjectName>: the DLL plus every content file the csproj
    marks CopyToOutputDirectory, keeping each file's folder. The default folder is created when BepInEx is
    installed. A PluginDir passed on the command line must already exist, else the deploy is skipped.
  -->
  <Target
    Name="DeployToGame"
    AfterTargets="Build"
    Condition="Exists('$(PluginDir)') Or ('$(PluginDir)' == '$(_DefaultPluginDir)' And Exists('$(BepInExDir)'))">
    <ItemGroup>
      <_DeployContent Include="@(None->WithMetadataValue('CopyToOutputDirectory', 'PreserveNewest'))" />
    </ItemGroup>
    <MakeDir Directories="$(PluginDir)" />
    <RemoveDir Directories="$(BepInExDir)\$(_OtherFolder)\$(MSBuildProjectName)" Condition="'$(_OtherFolder)' != ''" />
    <RemoveDir Directories="$(PluginDir)\$(MSBuildProjectName)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(PluginDir)\$(MSBuildProjectName)" />
    <Copy
      SourceFiles="@(_DeployContent)"
      DestinationFiles="@(_DeployContent->'$(PluginDir)\$(MSBuildProjectName)\%(RelativeDir)%(Filename)%(Extension)')"
      Condition="'@(_DeployContent)' != ''" />
    <Message Importance="high" Text="Deployed $(MSBuildProjectName) to $(PluginDir)" />
  </Target>

</Project>

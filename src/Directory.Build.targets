<Project>

  <!--
    Where a build lands. DeployTo is plugins (loaded once by the chainloader) or scripts (hot reloaded by
    ScriptEngine on F6), passed as -p:DeployTo=scripts. A project that must never be reloaded, such as Core,
    sets ScriptReloadable false and always goes to plugins. A preloader patcher sets BepInExPatcher true and
    always goes to patchers. A mod is removed from the other folder so it can never be loaded twice. PluginDir
    is kept as the name the Exists gate and the docs use, so -p:PluginDir=Z:/nope still compiles without
    deploying while the game runs.
  -->
  <PropertyGroup>
    <_DeployFolder>$(DeployTo)</_DeployFolder>
    <_DeployFolder Condition="'$(ScriptReloadable)' != 'true'">plugins</_DeployFolder>
    <_DeployFolder Condition="'$(BepInExPatcher)' == 'true'">patchers</_DeployFolder>
    <_OtherFolder Condition="'$(_DeployFolder)' == 'plugins'">scripts</_OtherFolder>
    <_OtherFolder Condition="'$(_DeployFolder)' == 'scripts'">plugins</_OtherFolder>
    <_DefaultPluginDir>$(BepInExDir)\$(_DeployFolder)</_DefaultPluginDir>
    <PluginDir Condition="'$(PluginDir)' == ''">$(_DefaultPluginDir)</PluginDir>
  </PropertyGroup>

  <!--
    Copies each plugin into BepInEx/<folder>/<ProjectName>: the DLL plus every content file the csproj
    marks CopyToOutputDirectory, keeping each file's folder. The default folder is created when BepInEx is
    installed. A PluginDir passed on the command line must already exist, else the deploy is skipped.
  -->
  <Target
    Name="DeployToGame"
    AfterTargets="Build"
    Condition="Exists('$(PluginDir)') Or ('$(PluginDir)' == '$(_DefaultPluginDir)' And Exists('$(BepInExDir)'))">
    <ItemGroup>
      <_DeployContent Include="@(None->WithMetadataValue('CopyToOutputDirectory', 'PreserveNewest'))" />
    </ItemGroup>
    <MakeDir Directories="$(PluginDir)" />
    <RemoveDir Directories="$(BepInExDir)\$(_OtherFolder)\$(MSBuildProjectName)" Condition="'$(_OtherFolder)' != ''" />
    <RemoveDir Directories="$(PluginDir)\$(MSBuildProjectName)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(PluginDir)\$(MSBuildProjectName)" />
    <Copy
      SourceFiles="@(_DeployContent)"
      DestinationFiles="@(_DeployContent->'$(PluginDir)\$(MSBuildProjectName)\%(RelativeDir)%(Filename)%(Extension)')"
      Condition="'@(_DeployContent)' != ''" />
    <Message Importance="high" Text="Deployed $(MSBuildProjectName) to $(PluginDir)" />
  </Target>

  <!--
    Builds a release zip for one plugin: artifacts/<ProjectName>-<Version>.zip, holding the plugin folder
    exactly as it deploys, its XML doc file when the project generates one, the repo's LICENSE renamed to LICENSE.txt,
    and the project's README.md. Opt in
    (dotnet build -t:Package -c Release), so a normal build stays as fast as it is.
  -->
  <Target Name="Package" DependsOnTargets="Build">
    <PropertyGroup>
      <_RepoRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..'))</_RepoRoot>
      <_ModName>$(MSBuildProjectName.Replace('Timbn.GraveyardKeeperTwo.', ''))</_ModName>
      <_PackageStage>$(IntermediateOutputPath)package\</_PackageStage>
      <_PackageRoot>$(_PackageStage)$(MSBuildProjectName)\</_PackageRoot>
      <_PackageFile>$(_RepoRoot)\artifacts\$(MSBuildProjectName)-$(Version).zip</_PackageFile>
    </PropertyGroup>
    <ItemGroup>
      <_PackageContent Include="@(None->WithMetadataValue('CopyToOutputDirectory', 'PreserveNewest'))" />
      <_PackageText Include="$(MSBuildProjectDirectory)\README.md" />
    </ItemGroup>
    <RemoveDir Directories="$(_PackageStage)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(_PackageRoot)" />
    <Copy
      SourceFiles="$(TargetDir)$(TargetName).xml"
      DestinationFolder="$(_PackageRoot)"
      Condition="'$(GenerateDocumentationFile)' == 'true' And Exists('$(TargetDir)$(TargetName).xml')" />
    <Copy
      SourceFiles="@(_PackageContent)"
      DestinationFiles="@(_PackageContent->'$(_PackageRoot)%(RelativeDir)%(Filename)%(Extension)')"
      Condition="'@(_PackageContent)' != ''" />
    <Copy
      SourceFiles="@(_PackageText)"
      DestinationFolder="$(_PackageRoot)"
      Condition="Exists('%(_PackageText.FullPath)')" />
    <Copy
      SourceFiles="$(_RepoRoot)\LICENSE"
      DestinationFiles="$(_PackageRoot)LICENSE.txt"
      Condition="Exists('$(_RepoRoot)\LICENSE')" />
    <MakeDir Directories="$(_RepoRoot)\artifacts" />
    <ZipDirectory SourceDirectory="$(_PackageStage)" DestinationFile="$(_PackageFile)" Overwrite="true" />
    <Message Importance="high" Text="Packaged $(_PackageFile)" />
  </Target>

  <!--
    Runs after Package for a project that sets ThunderstoreDescription and writes
    artifacts/thunderstore/<Namespace>-<Name>-<Version>.zip. The zip root holds manifest.json, the project's README.md,
    and docs/<ModName>/icon.png (256x256), next to the same plugin folder the release zip has. The Thunderstore name
    defaults to Product with underscores for spaces. A mod that declares a Core dependency depends on Core at that
    floor, raised to ThunderstoreCoreFirstVersion when it is older.
  -->
  <Target Name="PackageThunderstore" AfterTargets="Package" Condition="'$(ThunderstoreDescription)' != ''">
    <PropertyGroup>
      <ThunderstoreName Condition="'$(ThunderstoreName)' == ''">$(Product.Replace(' ', '_'))</ThunderstoreName>
      <_ThunderstoreStage>$(IntermediateOutputPath)thunderstore\</_ThunderstoreStage>
      <_ThunderstoreIcon>$(_RepoRoot)\docs\$(_ModName)\icon.png</_ThunderstoreIcon>
      <_ThunderstoreReadme>$(MSBuildProjectDirectory)\README.md</_ThunderstoreReadme>
      <_ThunderstoreFile>$(_RepoRoot)\artifacts\thunderstore\$(ThunderstoreNamespace)-$(ThunderstoreName)-$(Version).zip</_ThunderstoreFile>
    </PropertyGroup>
    <Error Condition="!Exists('$(_ThunderstoreIcon)')" Text="Thunderstore needs a 256x256 icon at $(_ThunderstoreIcon)" />
    <Error Condition="!Exists('$(_ThunderstoreReadme)')" Text="Thunderstore needs a README.md at $(_ThunderstoreReadme)" />
    <Warning
      Condition="'$(ThunderstoreBepInExPack)' == ''"
      Text="ThunderstoreBepInExPack is empty, so $(ThunderstoreName) does not depend on BepInEx. Set it in Directory.Build.props before uploading." />
    <TimbnFindCoreFloor Sources="@(Compile)" Condition="'$(MSBuildProjectName)' != 'Timbn.GraveyardKeeperTwo.Core'">
      <Output TaskParameter="Floor" PropertyName="_ThunderstoreCoreFloor" />
    </TimbnFindCoreFloor>
    <PropertyGroup Condition="'$(_ThunderstoreCoreFloor)' != ''">
      <_ThunderstoreCoreVersion>$(_ThunderstoreCoreFloor)</_ThunderstoreCoreVersion>
      <_ThunderstoreCoreVersion Condition="$([MSBuild]::VersionLessThan('$(_ThunderstoreCoreFloor)', '$(ThunderstoreCoreFirstVersion)'))">$(ThunderstoreCoreFirstVersion)</_ThunderstoreCoreVersion>
    </PropertyGroup>
    <ItemGroup>
      <_ThunderstoreDependency Include="$(ThunderstoreBepInExPack)" Condition="'$(ThunderstoreBepInExPack)' != ''" />
      <_ThunderstoreDependency Include="$(ThunderstoreCorePackage)-$(_ThunderstoreCoreVersion)" Condition="'$(_ThunderstoreCoreVersion)' != ''" />
    </ItemGroup>
    <RemoveDir Directories="$(_ThunderstoreStage)" />
    <ItemGroup>
      <_ThunderstorePlugin Include="$(_PackageRoot)**\*" />
    </ItemGroup>
    <Copy
      SourceFiles="@(_ThunderstorePlugin)"
      DestinationFiles="@(_ThunderstorePlugin->'$(_ThunderstoreStage)$(MSBuildProjectName)\%(RecursiveDir)%(Filename)%(Extension)')" />
    <Copy SourceFiles="$(_ThunderstoreIcon);$(_ThunderstoreReadme)" DestinationFolder="$(_ThunderstoreStage)" />
    <TimbnWriteThunderstoreManifest
      Path="$(_ThunderstoreStage)manifest.json"
      Name="$(ThunderstoreName)"
      Version="$(Version)"
      WebsiteUrl="$(ThunderstoreWebsiteUrl)"
      Description="$(ThunderstoreDescription)"
      Dependencies="@(_ThunderstoreDependency)" />
    <MakeDir Directories="$(_RepoRoot)\artifacts\thunderstore" />
    <ZipDirectory SourceDirectory="$(_ThunderstoreStage)" DestinationFile="$(_ThunderstoreFile)" Overwrite="true" />
    <Message Importance="high" Text="Packaged $(_ThunderstoreFile)" />
  </Target>

  <!--
    Runs after Package for a project that sets WorkshopDescription and writes artifacts/workshop/<ProjectName>/, holding
    content/BepInEx/plugins/<ProjectName> (the same plugin folder the release zip has, in the game folder layout) and
    item.vdf for steamcmd +workshop_build_item. WorkshopItemId is 0 until the first upload, which creates the item
    private with WorkshopDescription and writes its id into item.vdf. Copy that id into the csproj, and later uploads
    only update the files, title, and change note, so edits made on the Steam page stay.
  -->
  <Target Name="PackageWorkshop" AfterTargets="Package" Condition="'$(WorkshopDescription)' != ''">
    <PropertyGroup>
      <WorkshopItemId Condition="'$(WorkshopItemId)' == ''">0</WorkshopItemId>
      <_WorkshopStage>$(_RepoRoot)\artifacts\workshop\$(MSBuildProjectName)\</_WorkshopStage>
      <_WorkshopPreview>$(_RepoRoot)\docs\$(_ModName)\icon.png</_WorkshopPreview>
    </PropertyGroup>
    <Error Condition="!Exists('$(_WorkshopPreview)')" Text="The Workshop needs a preview image at $(_WorkshopPreview)" />
    <ItemGroup>
      <_WorkshopPlugin Include="$(_PackageRoot)**\*" />
    </ItemGroup>
    <RemoveDir Directories="$(_WorkshopStage)" />
    <Copy
      SourceFiles="@(_WorkshopPlugin)"
      DestinationFiles="@(_WorkshopPlugin->'$(_WorkshopStage)content\BepInEx\plugins\$(MSBuildProjectName)\%(RecursiveDir)%(Filename)%(Extension)')" />
    <TimbnWriteWorkshopItem
      Path="$(_WorkshopStage)item.vdf"
      ItemId="$(WorkshopItemId)"
      ContentFolder="$(_WorkshopStage)content"
      PreviewFile="$(_WorkshopPreview)"
      Title="$(Product)"
      Description="$(WorkshopDescription)"
      ChangeNote="$(Product) $(Version)" />
    <Message Importance="high" Text="Staged the Workshop item in $(_WorkshopStage)" />
  </Target>

  <UsingTask
    TaskName="TimbnWriteWorkshopItem"
    TaskFactory="RoslynCodeTaskFactory"
    AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Path Required="true" />
      <ItemId Required="true" />
      <ContentFolder Required="true" />
      <PreviewFile Required="true" />
      <Title Required="true" />
      <Description Required="true" />
      <ChangeNote Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System.IO" />
      <Using Namespace="System.Text" />
      <Code Type="Fragment" Language="cs"><![CDATA[
Func<string, string> quote = value => "\"" + value.Replace("\\", "\\\\").Replace("\"", "\\\"") + "\"";
var isNew = ItemId == "0";
var vdf = new StringBuilder()
    .Append("\"workshopitem\"\r\n{\r\n")
    .Append("\t\"appid\"\t\t\"4358690\"\r\n")
    .Append("\t\"publishedfileid\"\t\t").Append(quote(ItemId)).Append("\r\n")
    .Append("\t\"contentfolder\"\t\t").Append(quote(System.IO.Path.GetFullPath(ContentFolder))).Append("\r\n")
    .Append("\t\"previewfile\"\t\t").Append(quote(System.IO.Path.GetFullPath(PreviewFile))).Append("\r\n")
    .Append("\t\"title\"\t\t").Append(quote(Title)).Append("\r\n");
if (isNew)
{
    vdf.Append("\t\"visibility\"\t\t\"2\"\r\n")
        .Append("\t\"description\"\t\t").Append(quote(Description)).Append("\r\n");
}
vdf.Append("\t\"changenote\"\t\t").Append(quote(ChangeNote)).Append("\r\n")
    .Append("}\r\n");
File.WriteAllText(Path, vdf.ToString(), new UTF8Encoding(false));
]]></Code>
    </Task>
  </UsingTask>

  <UsingTask
    TaskName="TimbnFindCoreFloor"
    TaskFactory="RoslynCodeTaskFactory"
    AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Sources ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="true" />
      <Floor Output="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System.IO" />
      <Using Namespace="System.Text.RegularExpressions" />
      <Code Type="Fragment" Language="cs"><![CDATA[
foreach (var source in Sources)
{
    var match = Regex.Match(File.ReadAllText(source.GetMetadata("FullPath")), @"BepInDependency\(\s*TimbnCorePlugin\.Guid\s*,\s*""([^""]+)""");
    if (match.Success)
    {
        Floor = match.Groups[1].Value;
        break;
    }
}
]]></Code>
    </Task>
  </UsingTask>

  <UsingTask
    TaskName="TimbnWriteThunderstoreManifest"
    TaskFactory="RoslynCodeTaskFactory"
    AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Path Required="true" />
      <Name Required="true" />
      <Version Required="true" />
      <WebsiteUrl Required="true" />
      <Description Required="true" />
      <Dependencies ParameterType="System.String[]" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System.IO" />
      <Using Namespace="System.Linq" />
      <Using Namespace="System.Text" />
      <Using Namespace="System.Text.RegularExpressions" />
      <Code Type="Fragment" Language="cs"><![CDATA[
if (!Regex.IsMatch(Name, "^[A-Za-z0-9_]+$"))
{
    Log.LogError("Thunderstore name '{0}' may only hold letters, digits, and underscores.", Name);
}
if (!Regex.IsMatch(Version, @"^\d+\.\d+\.\d+$"))
{
    Log.LogError("Thunderstore version '{0}' must be Major.Minor.Patch.", Version);
}
if (Description.Length > 250)
{
    Log.LogError("Thunderstore description is {0} characters, the limit is 250.", Description.Length);
}
if (Log.HasLoggedErrors)
{
    return false;
}

Func<string, string> quote = value =>
{
    var builder = new StringBuilder("\"");
    foreach (var c in value)
    {
        switch (c)
        {
            case '"':
                builder.Append("\\\"");
                break;
            case '\\':
                builder.Append("\\\\");
                break;
            default:
                if (c < ' ')
                {
                    builder.AppendFormat("\\u{0:x4}", (int)c);
                }
                else
                {
                    builder.Append(c);
                }
                break;
        }
    }
    return builder.Append('"').ToString();
};

var dependencies = string.Join(", ", (Dependencies ?? new string[0]).Select(quote));
var json = new StringBuilder()
    .Append("{\r\n")
    .Append("  \"name\": ").Append(quote(Name)).Append(",\r\n")
    .Append("  \"version_number\": ").Append(quote(Version)).Append(",\r\n")
    .Append("  \"website_url\": ").Append(quote(WebsiteUrl)).Append(",\r\n")
    .Append("  \"description\": ").Append(quote(Description)).Append(",\r\n")
    .Append("  \"dependencies\": [").Append(dependencies).Append("]\r\n")
    .Append("}\r\n");
Directory.CreateDirectory(System.IO.Path.GetDirectoryName(Path));
File.WriteAllText(Path, json.ToString(), new UTF8Encoding(false));
]]></Code>
    </Task>
  </UsingTask>

</Project>

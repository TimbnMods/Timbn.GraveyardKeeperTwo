<Project>

  <PropertyGroup>
    <ModItemDirectory>$(ModsCodeDir)\$(MSBuildProjectName)</ModItemDirectory>
    <ModItemPluginDirectory>$(ModItemDirectory)\BepInEx\plugins\$(MSBuildProjectName)</ModItemPluginDirectory>
    <ScriptsItemDirectory>$(GameDir)\BepInEx\scripts\$(MSBuildProjectName)</ScriptsItemDirectory>
    <PluginsItemDirectory>$(GameDir)\BepInEx\plugins\$(MSBuildProjectName)</PluginsItemDirectory>
  </PropertyGroup>

  <!--
    DeployTo is scripts,mods,none
    Automatically handled but can be overridden with (-p:DeployTo)
    
    Scripts are hot reloaded by ScriptEngine on F6.
    Debug configurations go to scripts.
    
    Mods are put in the game's Mods/Code folder, which the game copies into BepInEx/plugins on launch like a Workshop item.
    Release configurations go to mods.
    ScriptReloadable == false always goes to mods.
    
    None compiles without deploying.
  -->
  <Choose>
    <When Condition="'$(DeployTo)' == 'none'">
      <PropertyGroup>
        <DeployFolder></DeployFolder>
      </PropertyGroup>
    </When>
    <When Condition="'$(DeployTo)' == 'mods'">
      <PropertyGroup>
        <DeployFolder>$(ModItemPluginDirectory)</DeployFolder>
      </PropertyGroup>
    </When>
    <When Condition="'$(DeployTo)' == 'scripts'">
      <Choose>
        <When Condition="'$(ScriptReloadable)' != 'true'">
          <PropertyGroup>
            <DeployFolder>$(ModItemPluginDirectory)</DeployFolder>
          </PropertyGroup>
        </When>
        <Otherwise>
          <PropertyGroup>
            <DeployFolder>$(ScriptsItemDirectory)</DeployFolder>
          </PropertyGroup>
        </Otherwise>
      </Choose>
    </When>
    <When Condition="'$(DeployTo)' == ''">
      <Choose>
        <When Condition="'$(ScriptReloadable)' != 'true' Or '$(Configuration)' == 'Release'">
          <PropertyGroup>
            <DeployFolder>$(ModItemPluginDirectory)</DeployFolder>
          </PropertyGroup>
        </When>
        <Otherwise>
          <PropertyGroup>
            <DeployFolder>$(ScriptsItemDirectory)</DeployFolder>
          </PropertyGroup>
        </Otherwise>
      </Choose>
    </When>
  </Choose>

  <Target
    Name="DeployToGame"
    AfterTargets="Build"
    Condition="'$(DeployFolder)' != '' And Exists('$(GameDir)')">
    <RemoveDir Directories="$(ScriptsItemDirectory)" />
    <RemoveDir Directories="$(ModItemDirectory)" />
    <RemoveDir Directories="$(PluginsItemDirectory)" Condition="'$(DeployFolder)' == '$(ScriptsItemDirectory)'" />

    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(DeployFolder)" />

    <ItemGroup>
      <_DeployContent Include="@(None->WithMetadataValue('CopyToOutputDirectory', 'PreserveNewest'))" />
    </ItemGroup>
    <Copy
      SourceFiles="@(_DeployContent)"
      DestinationFiles="@(_DeployContent->'$(DeployFolder)\%(RelativeDir)%(Filename)%(Extension)')"
      Condition="'@(_DeployContent)' != ''" />

    <PropertyGroup>
      <_ModInfoJson>
        {
        "schemaVersion": 1,
        "id": "$(AssemblyName.ToLowerInvariant())",
        "name": "$(Product)",
        "version": "$(Version)"
        }
      </_ModInfoJson>
    </PropertyGroup>
    <WriteLinesToFile
      File="$(ModItemDirectory)\modinfo.json"
      Lines="$(_ModInfoJson)"
      Overwrite="true"
      Condition="'$(DeployFolder)' == '$(ModItemPluginDirectory)'" />

    <Message Importance="high" Text="Deployed $(MSBuildProjectName) to $(DeployFolder)" />
  </Target>

</Project>

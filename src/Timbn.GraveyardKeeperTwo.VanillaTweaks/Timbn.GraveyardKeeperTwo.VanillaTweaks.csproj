<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>Timbn.GraveyardKeeperTwo.VanillaTweaks</AssemblyName>
    <Product>Timbn Vanilla Tweaks</Product>
    <Version>1.14.0</Version>
    <NexusModId>66</NexusModId>
    <Thunderstore>true</Thunderstore>
    <Description>Fixes bugs and soft locks and adds light tweaks that keep the vanilla experience without cheating. Almost every fix and tweak can be turned off on its own.</Description>
    <SteamWorkshop>true</SteamWorkshop>
    <WorkshopItemId>3810071056</WorkshopItemId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Timbn.GraveyardKeeperTwo.Core\Timbn.GraveyardKeeperTwo.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="AstarPathfindingProject">
      <HintPath>$(GameManagedDir)\AstarPathfindingProject.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Sirenix.Serialization">
      <HintPath>$(GameManagedDir)\Sirenix.Serialization.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>

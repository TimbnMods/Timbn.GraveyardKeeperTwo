<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>Timbn.GraveyardKeeperTwo.VanillaTweaks</AssemblyName>
    <Product>Timbn Vanilla Tweaks</Product>
    <Version>1.9.0</Version>
    <ThunderstoreName>TimbnVanillaTweaks</ThunderstoreName>
    <ThunderstoreDescription>Fixes bugs and soft locks and adds light tweaks that keep the vanilla experience without cheating. Almost every fix and tweak can be turned off on its own.</ThunderstoreDescription>
    <SteamWorkshop>true</SteamWorkshop>
    <WorkshopItemId>3810071056</WorkshopItemId>
  </PropertyGroup>

  <!-- Lands in BepInEx/scripts by default so F6 reloads it. Pass -p:DeployTo=plugins to load it at startup instead. -->
  <PropertyGroup>
    <DeployTo>scripts</DeployTo>
  </PropertyGroup>

  <ItemGroup>
    <None Include="lang\*.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Timbn.GraveyardKeeperTwo.Core\Timbn.GraveyardKeeperTwo.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>..\..\lib\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="AstarPathfindingProject">
      <HintPath>$(GameManagedDir)\AstarPathfindingProject.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Sirenix.Serialization">
      <HintPath>$(GameManagedDir)\Sirenix.Serialization.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="LazyBearTechnology">
      <HintPath>$(GameManagedDir)\LazyBearTechnology.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>

<Project>

  <!--Default csproj settings and packages shared by every project.-->
  <PropertyGroup>
    <Version>0.1.0</Version>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <DebugType>embedded</DebugType>
    <PathMap>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)'))=/_/</PathMap>
    <RestoreAdditionalProjectSources>
      https://api.nuget.org/v3/index.json;
      https://nuget.bepinex.dev/v3/index.json
    </RestoreAdditionalProjectSources>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.Analyzers" Version="1.*" PrivateAssets="all" />
    <PackageReference Include="BepInEx.Core" Version="5.*" />
    <PackageReference Include="BepInEx.PluginInfoProps" Version="2.*" PrivateAssets="all" />
    <PackageReference Include="UnityEngine.Modules" Version="6000.3.9" IncludeAssets="compile" />
  </ItemGroup>

  <!--
    Variables for the modding environment. Change these if you have different paths.
    Things projects can override or set:
    WorkshopItemId (int, the mod's ID on Steam Workshop)
    NexusModId (int, the mod's ID on Nexus Mods)
    PropertyGroup.ScriptReloadable (bool, if the mod can be deployed to script folder)
    SkipThunderstore (bool, if the mod should not be released to Thunderstore)
  -->
  <PropertyGroup>
    <GameDir>$(MSBuildProgramFiles32)\Steam\steamapps\common\Graveyard Keeper 2</GameDir>
    <GameManagedDir>$(GameDir)\GraveyardKeeper2_Data\Managed</GameManagedDir>
    <ModsCodeDir>$(USERPROFILE)\AppData\LocalLow\Lazy Bear Games\Graveyard Keeper 2\Mods\Code</ModsCodeDir>
    <ScriptReloadable Condition="'$(ScriptReloadable)' == ''">true</ScriptReloadable>
  </PropertyGroup>

  <!--Always publish to Thunderstore unless SkipThunderstore is set to true or version is less than 1.0.0.-->
  <PropertyGroup>
    <ThunderstoreNamespace>Timbn</ThunderstoreNamespace>
    <ThunderstoreWebsiteUrl>https://github.com/TimbnMods/Timbn.GraveyardKeeperTwo</ThunderstoreWebsiteUrl>
    <ThunderstoreCorePackage>Timbn-TimbnCore</ThunderstoreCorePackage>
  </PropertyGroup>

  <!--The game's DLLs and lang folder-->
  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(GameManagedDir)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="LazyBearTechnology">
      <HintPath>$(GameManagedDir)\LazyBearTechnology.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <None Include="lang\*.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
